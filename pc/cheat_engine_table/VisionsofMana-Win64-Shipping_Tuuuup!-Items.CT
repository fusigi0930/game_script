[ENABLE]
aobscanmodule(playercontrol,VisionsofMana-Win64-Shipping.exe,49 8B 4F 30 48 85 C9 0F 84 B2)
registersymbol(playercontrol playercontrolbkp pbase2 plstate ppawn)
alloc(newmem,128)
label(return code clean pbase2 plstate ppawn)
label(playercontrolbkp)
newmem:
 mov rcx,[r15+30] // plcontroll
  test rcx,rcx
je code
mov [pbase2],rcx
push rsi
mov rsi,[rcx+228] //plsate
test rsi,rsi
je clean
mov [plstate],rsi
mov rsi,[rcx+250] // pawn
test rsi,rsi
je clean
cmp byte ptr [rsi+713],1
jne clean
mov [ppawn],rsi

clean:
pop rsi
code:
  mov rcx,[r15+30]
  test rcx,rcx
  jmp return
  
  align 10 cc
  
playercontrolbkp:
readmem(playercontrol,7)

align 10 cc
pbase2:
dq 0

plstate:
dq 0

ppawn:
dq 0
freejumpmem+40:
 jmp newmem

playercontrol:
  jmp freejumpmem+40
  nop 2
return:

[DISABLE]
playercontrol:
 // db 49 8B 4F 30 48 85 C9
readmem(playercontrolbkp,7)
