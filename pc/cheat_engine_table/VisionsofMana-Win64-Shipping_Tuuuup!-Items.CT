          <CheatEntries>
            <CheatEntry>
              <ID>356743</ID>
              <Description>"Godmode + damage multiplier"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">{  Game Executable   : VisionsofMana-Win64-Shipping.exe
   Author            : Tuuup!
   Executable Version: 1.0.2.0
   Script Date       : 2024-08-30
}
[ENABLE]
aobscanmodule(healthdamage,VisionsofMana-Win64-Shipping.exe,F3 0F 5C CE F3 0F 58 C9)
registersymbol(healthdamage healthdamagebkp godm damage dmp)
alloc(newmem,128)
label(return code godm damage dmp)
label(healthdamagebkp)
newmem:

mov rax,[rbx+20]
test rax,rax
jz code
cmp qword ptr [rax+280],00
je code
cmp byte ptr [rax+328],#0 // is splayer ... 328 = team nember
jne @f
cmp [godm],1
jne code
xorps xmm6,xmm6
 addss xmm1,xmm1
  jmp return

@@:

cmp [damage],1
jne code
mulss xmm6,[dmp]



code:
  subss xmm1,xmm6
  addss xmm1,xmm1
  jmp return
  
  align 10 cc
  
healthdamagebkp:
readmem(healthdamage,8)

align 10 cc
godm:
dd 0
damage:
dd 0
dmp:
dd (float)2

freejumpmem+10:
 jmp newmem

healthdamage:
  jmp freejumpmem+10
  nop 3
return:

[DISABLE]
healthdamage:
 // db F3 0F 5C CE F3 0F 58 C9
readmem(healthdamagebkp,8)
unregistersymbol(*)
dealloc(*)

