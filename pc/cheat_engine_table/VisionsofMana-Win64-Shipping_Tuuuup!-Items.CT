    <CheatEntry>
      <ID>115509</ID>
      <Description>"&lt;=== Auto attach to process "</Description>
      <Options moDeactivateChildrenAsWell="1"/>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
  if(getCEVersion() &lt; 7.3) then
    ShowMessage('Warning! CE version should be 7.3 or above')
  end

OpenProcess("VisionsofMana-Win64-Shipping.exe")
  if(process == nil) then
    ShowMessage('The process VisionsofMana-Win64-Shipping.exe is NOT found!')
  end
{$asm}
