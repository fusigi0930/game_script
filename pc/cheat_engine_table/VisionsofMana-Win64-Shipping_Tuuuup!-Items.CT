if mpTimer == nil then
else
mpTimer.destroy()
end
[ENABLE]

mpTimer = createTimer()
mpTimer.setInterval(1000)
mpTimer.onTimer = function()

local pg = getAddressSafe('[ppawn]')
 if pg ~= nil then
 local play = readByte('[ppawn]+713')
 local play2 = 1
 --print(play)
  if play == play2 then

    local pg2 = getAddressSafe('[[ppawn]+240]')
    if pg2 ~= nil then
     local pg3 = readFloat('[[[ppawn]+240]+338]')
      if pg3 ~= nil then
         local pg3 = readFloat('[[[[ppawn]+240]+338]+140]')
          if pg3 ~= nil then
           local pg4 = readFloat('[[[[[ppawn]+240]+338]+140]+0]')
            if pg4 ~= nil then

     local mpen = readFloat('[[[[[ppawn]+240]+338]+140]+0]+98')
  writeFloat('[[[[[ppawn]+240]+338]+140]+0]+8C',mpen)
 end
end
end
end
end
end
end

