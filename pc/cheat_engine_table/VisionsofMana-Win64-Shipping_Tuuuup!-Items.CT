              <CheatEntries>
                <CheatEntry>
                  <ID>358987</ID>
                  <Description>"Set CP/SP to current Max ( Always use CP )"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{  Game Executable   :
   Author            : Tuuup!
   Executable Version:
   Script Date       :
}

{$lua}
if syntaxcheck then return end
if cpspTimer == nil then
else
cpspTimer.destroy()
end
[ENABLE]

cpspTimer = createTimer()
cpspTimer.setInterval(1000)
cpspTimer.onTimer = function()

local pg = getAddressSafe('[ppawn]')
 if pg ~= nil then
 local play = readByte('[ppawn]+713')
 local play2 = 1
 --print(play)
  if play == play2 then

    local pg2 = getAddressSafe('[[ppawn]+240]')
    if pg2 ~= nil then
     local pg3 = readFloat('[[[ppawn]+240]+338]')
      if pg3 ~= nil then
         local pg3 = readFloat('[[[[ppawn]+240]+338]+140]')
          if pg3 ~= nil then
           local pg4 = readFloat('[[[[[ppawn]+240]+338]+140]+0]')
            if pg4 ~= nil then


     local hpen = readFloat('[[[[[ppawn]+240]+338]+140]+0]+D8')
  writeFloat('[[[[[ppawn]+240]+338]+140]+0]+CC',hpen)
 end
end
end
end
